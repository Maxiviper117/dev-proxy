{
  "name": "@maxiviper117/devproxy",
  "version": "0.26.0",
  "description": "Cross-platform CLI for stable HTTPS local domains that proxy to local development services.",
  "keywords": [
    "caddy",
    "cli",
    "https",
    "local-development",
    "reverse-proxy",
    "linux",
    "macos",
    "windows",
    "wsl"
  ],
  "homepage": "https://github.com/Maxiviper117/dev-proxy#readme",
  "bugs": {
    "url": "https://github.com/Maxiviper117/dev-proxy/issues"
  },
  "license": "MIT",
  "author": "Maxiviper117",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maxiviper117/dev-proxy.git"
  },
  "bin": {
    "devproxy": "dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node -e \"fs.cpSync('src/core/config-schema.json', 'dist/core/config-schema.json')\" && pnpm build:ui",
    "build:ui": "vite build -c vite.ui.config.ts",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "pack:dry": "pnpm pack --dry-run",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "inquirer-checkbox-plus-plus": "^1.1.1",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^25.6.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "svelte": "^5.37.0",
    "tailwindcss": "^4.1.14",
    "vite": "^7.3.1",
    "vitepress": "2.0.0-alpha.17",
    "vitest": "^4.1.5",
    "vue": "^3.5.33"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0"
}
